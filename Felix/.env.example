# =============================================================================
# Felix Empire Trading - Variaveis de ambiente
# Copie para .env.local e preencha os valores. NUNCA commitar segredos reais.
# =============================================================================

# -------- Ambiente --------
NODE_ENV=development
LOG_LEVEL=info

# -------- Frontend (apps/web) --------
# Use /api (relativo) para http://localhost e http://localhost:3000 com proxy nginx.
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SENTRY_DSN=

# -------- Supabase (servidor / microserviços no Docker) --------
# Em dev com Supabase CLI (rede supabase_network_felix-empire-trading):
# SUPABASE_URL=http://kong:8000
# (browser usa VITE_SUPABASE_URL com 127.0.0.1:54321)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------- Postgres direto (dev local via supabase start) --------
POSTGRES_HOST=localhost
POSTGRES_PORT=54322
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# -------- LLM / RAG --------
LLM_API_BASE=http://ollama:11434/v1
LLM_MODEL=qwen2.5:1.5b
LLM_API_KEY=
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=60000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# -------- E-mail (Resend) --------
RESEND_API_KEY=
EMAIL_FROM="Felix Empire Trading <no-reply@felix-empire.local>"

# -------- Anti-cheat / Avaliacoes --------
ASSESSMENT_MIN_SECONDS_PER_QUESTION=5
ASSESSMENT_MAX_ATTEMPTS=3
PASSING_SCORE=0.75

# -------- Certificado --------
CERTIFICATE_PUBLIC_VERIFY_BASE_URL=http://localhost/verify
CERTIFICATE_ISSUER_NAME=Empire Trading

# -------- Observabilidade --------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=felix
SENTRY_DSN=

# -------- Gateway / Rate limit --------
RATE_LIMIT_RPM=120
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
